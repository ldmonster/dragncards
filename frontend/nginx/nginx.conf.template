server {

  listen 80;

  client_max_body_size 64m;

  # __SUBPATH__ is replaced at container start by entrypoint.sh.
  # Set NGINX_BASE_PATH env var (e.g. /dragncards) to serve at a sub-path.
  # Leave NGINX_BASE_PATH empty (default) for root deployment.

  location __SUBPATH__/ {
    alias  /usr/share/nginx/html/;
    index  index.html index.htm;
    try_files $uri __SUBPATH__/index.html;
  }

  location __SUBPATH__/be/socket/ {
      proxy_pass http://backend:4000/socket/;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
  location __SUBPATH__/be/ {
      # strip __SUBPATH__/be prefix before forwarding to Phoenix
      rewrite ^__SUBPATH__/be/(.*)$ /$1 break;
      proxy_pass http://backend:4000;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Browsers always request /favicon.ico at the root regardless of subpath
  location = /favicon.ico {
    alias /usr/share/nginx/html/favicon.ico;
  }

  error_page   500 502 503 504  /50x.html;

  location = /50x.html {
    root   /usr/share/nginx/html;
  }
}
